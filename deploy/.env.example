# ==============================================================================
# Beru Hub Configuration Template
# Copy this file to .env and adjust variables for your deployment environment.
# ==============================================================================

# Application & Networking
APP_NAME="Beru Hub"
DEBUG=false
DOMAIN=localhost
HUB_BASE_URL=https://localhost
DATABASE_URL=sqlite:///./data/beru.db

# Security & Credentials
# Generate a 32-byte Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TRANSFER_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=

# Inactivity & Expirations
WS_TICKET_EXPIRE_SECONDS=30
DEVICE_TOKEN_INACTIVITY_DAYS=90
PAIRING_MAX_FAILED_ATTEMPTS=5
PAIRING_LOCKOUT_MINUTES=10
PAIRING_CODE_EXPIRE_SECONDS=60
BACKUP_DIR=./data/backups
BACKUP_RETENTION_COUNT=14

# Cloud AI & Local LLM Provider Keys
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# STT & TTS Settings
DEFAULT_STT_PROVIDER=groq
DEFAULT_TTS_PROVIDER=client
PIPER_MODEL_PATH=

# Resilience & Rate Limiting
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_SECONDS=30.0
IDEMPOTENCY_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE_IP=120
RATE_LIMIT_PER_MINUTE_DEVICE=240
MAX_WS_MESSAGE_SIZE_BYTES=65536
